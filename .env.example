# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google AI (Gemini)
GOOGLE_AI_API_KEY=your-google-ai-api-key

# WhatsApp Business API (Meta Cloud API)
WHATSAPP_ACCESS_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# Owner notify fallback (also settable in business profile)
OWNER_NOTIFY_PHONE=

# Public app URL for dashboard links in owner notifications
APP_BASE_URL=http://localhost:3000

# Optional shared secret for /dashboard and /api (except WhatsApp webhook)
DASHBOARD_PASSWORD=

# Google Calendar OAuth (parked — unused in v1 intake)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# 32-byte key as 64 hex chars: openssl rand -hex 32
GOOGLE_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
